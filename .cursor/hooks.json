{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/stop-domain-check.js",
        "timeout": 120,
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/block-destructive-shell.js",
        "failClosed": true
      }
    ]
  }
}
