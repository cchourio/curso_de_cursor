{
  "name": "feature-flags",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ff/db test",
    "db:generate": "pnpm --filter @ff/db db:generate",
    "db:migrate": "pnpm --filter @ff/db db:migrate",
    "db:seed": "pnpm --filter @ff/db db:seed",
    "db:reset": "pnpm --filter @ff/db db:reset"
  }
}
